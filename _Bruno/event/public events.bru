meta {
  name: public events
  type: http
  seq: 5
}

get {
  url: {{host}}/event/public?includeAll=true
  body: none
  auth: none
}

params:query {
  includeAll: true
  ~limit: 2
  ~cursor: 21a6928a-7bbf-4df7-a591-2f11079bae3c
  ~longitude: 74.872261
  ~latitude: 31.633980
}

script:post-response {
  bru.setEnvVar("eventId",res.body.data[0].eventId)
}

settings {
  encodeUrl: true
  timeout: 0
}
