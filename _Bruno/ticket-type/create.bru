meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host}}/ticket-type/{{eventId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Early Bird",
    "description": "Discounted ticket for early registrants.",
    "price": 150,
    "discountedPrice": 100,
    "discountReason": "Limited-time early bird offer",
    "quantity": 100,
    "salesCutoff": "2025-12-01T23:59:59.000Z"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
