meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host}}/ticket-type/{{eventId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Early Bird",
    "description": "Discounted ticket for early registrants.",
    "price": 150,
    "discountedPrice": 100,
    "discountReason": "Limited-time early bird offer",
    "quantity": 100,
    "salesCutoff": "2025-12-01T23:59:59.000Z",
    "customField": [
      {
        "label": "Dietary Preference",
        "fieldType": "dropdown",
        "required": false,
        "options": "Vegetarian,Non-Vegetarian,Vegan,Other"
      },
      {
        "label": "Something more",
        "fieldType": "dropdown",
        "required": false,
        "options": "Vegetarian,Non-Vegetarian,Vegan,Other"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
