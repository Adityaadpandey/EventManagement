meta {
  name: events
  type: http
  seq: 2
}

get {
  url: {{host}}/discount/event/{{eventId}}
  body: json
  auth: inherit
}

body:json {
  {
    "code": "FALL2025",
    "discountPct": 50,
    "maxDiscount":1000,
    "maxUses": 100,
    "validFrom": "2025-10-10T00:00:00.000Z",
    "validTo": "2025-12-31T23:59:59.000Z"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
