{
  "name": "@repo/database",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/client.js",
  "module": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "files": [
    "dist/",
    "prisma/schema.prisma"
  ],
  "author": "aditya",
  "scripts": {
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "format": "prisma format",
    "generate": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "npm run generate",
    "predev": "npm run generate",
    "studio": "prisma studio",
    "build": "npm run generate && tsc && npm run copy-generated",
    "copy-generated": "cp -r ./generated ./dist/",
    "build:pack": "npm run build && npm pack",
    "clean": "rm -rf dist generated node_modules/.prisma",
    "postinstall": "npm run generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "latest",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "../config-typescript",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "eslint": "^8.57.0",
    "prisma": "latest",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
