{
	"name": "eventmanagement",
	"private": true,
	"scripts": {
		"check": "biome check --write . --max-diagnostics=1000",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"build:packages": "pnpm -r --filter @repo/* run build",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"prettier": "^3.6.2",
		"turbo": "^2.5.5",
		"typescript": "5.9.2"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write . --max-diagnostics=1000"
		]
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	}
}
