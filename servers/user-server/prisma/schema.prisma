generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  userId                                     String                        @id @default(uuid())
  phone                                      String?                       @unique
  email                                      String?                       @unique
  password                                   String?
  name                                       String?
  avatar                                     String?
  isActive                                   Boolean                       @default(true)
  phoneVerified                              Boolean                       @default(false)
  emailVerified                              Boolean                       @default(false)
  profileComplete                            Boolean                       @default(false)
  role                                       Role                          @default(USER)
  createdAt                                  DateTime                      @default(now())
  updatedAt                                  DateTime                      @updatedAt
  bio                                        String?
  googleId                                   String?                       @unique
  interests                                  String[]
  Booking                                    Booking[]
  CheckIn                                    CheckIn[]
  DiscountCode                               DiscountCode[]
  EventBookmark                              EventBookmark[]
  EventCohost                                EventCohost[]
  EventFeedback                              EventFeedback[]
  EventFollow                                EventFollow[]
  EventLike                                  EventLike[]
  EventReport                                EventReport[]
  Invitation                                 Invitation[]
  Lister                                     Lister?
  ListerFollow                               ListerFollow[]
  ListerNotificationPreference               ListerNotificationPreference?
  Notification                               Notification[]
  OpsChatMessage                             OpsChatMessage[]
  OpsEmail                                   OpsEmail[]
  OpsEventTeam                               OpsEventTeam[]
  OpsInvite                                  OpsInvite[]
  OpsOrgMember                               OpsOrgMember[]
  OpsRelation_OpsRelation_linkedUserIdToUser OpsRelation[]                 @relation("OpsRelation_linkedUserIdToUser")
  OpsRelation_OpsRelation_ownerIdToUser      OpsRelation[]                 @relation("OpsRelation_ownerIdToUser")
  OpsTask_OpsTask_assigneeIdToUser           OpsTask[]                     @relation("OpsTask_assigneeIdToUser")
  OpsTask_OpsTask_ownerIdToUser              OpsTask[]                     @relation("OpsTask_ownerIdToUser")
  OpsTimelineEvent                           OpsTimelineEvent[]
  Payment                                    Payment[]
  PushSubscription                           PushSubscription[]
  Referral                                   Referral[]
  Refund                                     Refund[]
  SlotBooking                                SlotBooking[]
  TeamMember                                 TeamMember[]
  Ticket                                     Ticket[]
  TicketScanLog                              TicketScanLog[]
  VenueStaff                                 VenueStaff[]
  WaitlistEntry                              WaitlistEntry[]

  @@index([role, isActive])
  @@index([createdAt(sort: Desc)])
  @@index([email, isActive])
  @@index([phone, isActive])
  @@index([interests], type: Gin)
}

model Lister {
  listerId                                          String                 @id @default(uuid())
  userId                                            String                 @unique
  companyName                                       String?
  companyLogo                                       String?
  bio                                               String?
  createdAt                                         DateTime               @default(now())
  updatedAt                                         DateTime               @updatedAt
  status                                            ListerStatus           @default(PENDING)
  website                                           String?
  contactEmail                                      String?
  contactPhone                                      String?
  about                                             String?
  facebookLink                                      String?
  followersCount                                    Int                    @default(0)
  founderInfo                                       String?
  instagramLink                                     String?
  isFeatured                                        Boolean                @default(false)
  isSubscribed                                      Boolean                @default(false)
  isVerified                                        Boolean                @default(false)
  linkedinLink                                      String?
  totalEventsHosted                                 Int                    @default(0)
  wikidataQid                                       String?
  xLink                                             String?
  youtubeLink                                       String?
  Account                                           Account?
  BankDetails                                       BankDetails?
  CRMContact                                        CRMContact[]
  DiscountCode                                      DiscountCode[]
  EmailCampaign                                     EmailCampaign[]
  Event                                             Event[]
  EventComms                                        EventComms[]
  InboxEmail                                        InboxEmail[]
  user                                              User                   @relation(fields: [userId], references: [userId])
  ListerAnalytics                                   ListerAnalytics?
  ListerEmailAccount                                ListerEmailAccount?
  ListerFollow                                      ListerFollow[]
  ListerMeetingAccount                              ListerMeetingAccount[]
  ListerRazorpayConfig                              ListerRazorpayConfig?
  ListerSubscription                                ListerSubscription?
  OpsEmailTemplate                                  OpsEmailTemplate[]
  OpsInvite                                         OpsInvite[]
  OpsOrgMember                                      OpsOrgMember[]
  Partnership_Partnership_organizerListerIdToLister Partnership[]          @relation("Partnership_organizerListerIdToLister")
  Partnership_Partnership_partnerListerIdToLister   Partnership[]          @relation("Partnership_partnerListerIdToLister")
  Payout                                            Payout[]
  TicketChecker                                     TicketChecker[]
  Vendor                                            Vendor[]
  Venue                                             Venue[]

  @@index([status, createdAt(sort: Desc)])
  @@index([followersCount(sort: Desc)])
  @@index([isVerified, isFeatured])
}

model BankDetails {
  bankDetailsId     String   @id @default(uuid())
  listerId          String   @unique
  bankName          String
  accountNumber     String
  ifscCode          String
  accountHolderName String
  branchCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lister            Lister   @relation(fields: [listerId], references: [listerId])
}

model Account {
  accountId   String        @id @default(uuid())
  listerId    String        @unique
  balance     Decimal       @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lister      Lister        @relation(fields: [listerId], references: [listerId])
  LedgerEntry LedgerEntry[]

  @@index([balance])
  @@index([balance(sort: Desc), listerId], map: "idx_account_high_balance", where: raw("(balance > (1000)::numeric)"))
}

model Payout {
  payoutId        String       @id @default(uuid())
  listerId        String
  eventId         String?
  type            PayoutType   @default(FULL)
  amount          Decimal
  approvedAmount  Decimal?
  status          PayoutStatus @default(PENDING)
  remark          String?
  requestedAt     DateTime     @default(now())
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  failureReason   String?
  netAmount       Decimal
  paymentMethod   String?
  platformFee     Decimal      @default(0)
  processedAt     DateTime?
  processingNotes String?
  refundedAmount  Decimal      @default(0)
  scheduledFor    DateTime?
  transactionId   String?
  event           Event?       @relation(fields: [eventId], references: [eventId])
  lister          Lister       @relation(fields: [listerId], references: [listerId])

  @@index([status, requestedAt(sort: Desc)])
  @@index([listerId, status])
  @@index([eventId, status])
  @@index([scheduledFor])
  @@index([amount(sort: Desc), status], map: "idx_payout_amount_status", where: raw("(status <> 'CANCELLED'::\"PayoutStatus\")"))
  @@index([paidAt(sort: Desc), listerId, amount], map: "idx_payout_completed", where: raw("(status = 'COMPLETED'::\"PayoutStatus\")"))
  @@index([eventId, type, status, requestedAt(sort: Desc)], map: "idx_payout_event_type", where: raw("(\"eventId\" IS NOT NULL)"))
  @@index([listerId, requestedAt(sort: Desc)], map: "idx_payout_pending", where: raw("(status = ANY (ARRAY['PENDING'::\"PayoutStatus\", 'PROCESSING'::\"PayoutStatus\"]))"))
  @@index([status, requestedAt(sort: Desc), listerId], map: "idx_payout_pending_priority", where: raw("(status = ANY (ARRAY['PENDING'::\"PayoutStatus\", 'PROCESSING'::\"PayoutStatus\"]))"))
}

model LedgerEntry {
  id            String   @id @default(uuid())
  accountId     String
  entryType     String
  amount        Decimal
  balanceAfter  Decimal
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())
  account       Account  @relation(fields: [accountId], references: [accountId])

  @@index([accountId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([accountId, createdAt(sort: Desc), amount], map: "idx_ledger_credits", where: raw("(\"entryType\" = 'CREDIT'::text)"))
  @@index([accountId, createdAt(sort: Desc), amount], map: "idx_ledger_debits", where: raw("(\"entryType\" = 'DEBIT'::text)"))
  @@index([referenceType, referenceId, createdAt(sort: Desc)], map: "idx_ledger_reference_complete", where: raw("((\"referenceType\" IS NOT NULL) AND (\"referenceId\" IS NOT NULL))"))
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Event {
  eventId               String                @id @default(uuid())
  listerId              String
  title                 String
  description           String
  banner_horizontal     String
  banner_vertical       String
  banner_square         String
  date                  DateTime
  time                  DateTime
  location              String
  capacity              Int?
  status                Status                @default(NOT_VIEWED)
  rejection_comment     String?
  cancellation_note     String?
  samplePoster          String?
  socialMediaGraphic    String?
  eventFormat           String?
  requestedVenue        String?
  termsConditions       String?
  rulesRegulations      String?
  policies              String?
  dutyLeavesDetails     String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  chips                 String[]
  latitude              Float?
  longitude             Float?
  restrictions          String?
  tags                  String[]
  availableMailUpdates  Int                   @default(2)
  ticketCounter         Int                   @default(0)
  canBuy                Boolean               @default(true)
  aboutArtist           String?
  autoPromoteWaitlist   Boolean               @default(false)
  autoTeamFill          Boolean               @default(false)
  certificateInfo       String?
  clonedFromEventId     String?
  customApiKey          String?
  customUrl             String?               @unique
  embeddable            Boolean               @default(true)
  endDate               DateTime?
  endTime               DateTime?
  eventCategory         EventCategory?
  eventTheme            Json?
  eventType             EventType             @default(SOLO)
  externalMeetingId     String?
  faqContent            String?
  gmeetLink             String?
  groupBookingEnabled   Boolean               @default(false)
  healthNotes           String?
  healthStatus          EventHealthStatus     @default(GOOD)
  healthStatusUpdatedAt DateTime?
  isFeatured            Boolean               @default(false)
  mapDirections         String?
  maxTeamSize           Int?
  maxTeams              Int?
  maxTicketsPerPerson   Int?
  maxWaitlistSize       Int?
  meetingProvider       MeetingProvider?
  minTeamSize           Int?
  minTeams              Int?
  postponement_note     String?
  prizesGoodies         String?
  requiresApproval      Boolean               @default(false)
  saleEndsAt            DateTime?
  saleStartsAt          DateTime?
  salesPaused           Boolean               @default(false)
  salesPausedAt         DateTime?
  showOnDiscover        Boolean               @default(true)
  showOnHomePage        Boolean               @default(false)
  subCategory           String?
  thumbnail             String?
  ticketingEnabled      Boolean               @default(true)
  timeline              String?
  venueDetails          String?
  visibility            EventVisibility       @default(PUBLIC)
  zoomLink              String?
  Booking               Booking[]
  CheckIn               CheckIn[]
  CustomField           CustomField[]
  DiscountCode          DiscountCode[]
  lister                Lister                @relation(fields: [listerId], references: [listerId])
  EventAnalytics        EventAnalytics?
  EventBookmark         EventBookmark[]
  EventCohost           EventCohost[]
  EventComms            EventComms[]
  EventFeedback         EventFeedback[]
  EventFollow           EventFollow[]
  EventGallery          EventGallery[]
  EventLike             EventLike[]
  EventOffering         EventOffering[]
  EventReminderSetting  EventReminderSetting?
  EventReport           EventReport[]
  EventSection          EventSection[]
  EventSyndication      EventSyndication[]
  EventTimeSlot         EventTimeSlot[]
  InboxEmail            InboxEmail[]
  Invitation            Invitation[]
  OpsChat               OpsChat[]
  OpsEmail              OpsEmail[]
  OpsEventSettings      OpsEventSettings?
  OpsEventTeam          OpsEventTeam[]
  OpsMoneyItem          OpsMoneyItem[]
  OpsRelation           OpsRelation[]
  OpsTask               OpsTask[]
  OpsTimelineEvent      OpsTimelineEvent[]
  Partnership           Partnership[]
  Payment               Payment[]
  Payout                Payout[]
  RSVP                  RSVP[]
  Refund                Refund[]
  Team                  Team[]
  Ticket                Ticket[]
  TicketChecker         TicketChecker[]
  TicketScanLog         TicketScanLog[]
  TicketType            TicketType[]
  TicketTypeGroup       TicketTypeGroup[]
  WaitlistEntry         WaitlistEntry[]

  @@index([status, date])
  @@index([listerId, status, createdAt(sort: Desc)])
  @@index([date, status])
  @@index([tags], type: Gin)
  @@index([customUrl])
  @@index([eventType, eventCategory])
  @@index([healthStatus])
  @@index([isFeatured, showOnHomePage])
  @@index([isFeatured, visibility, status, date])
  @@index([latitude, longitude])
  @@index([listerId, date])
  @@index([saleStartsAt, saleEndsAt])
  @@index([visibility, status, date])
  @@index([visibility, status, showOnDiscover, date])
  @@index([visibility, status, showOnHomePage, date])
  @@index([date, listerId], map: "idx_event_approved_date", where: raw("(status = 'APPROVED'::\"Status\")"))
}

model CustomField {
  fieldId               String                  @id @default(uuid())
  eventId               String
  label                 String
  fieldType             String
  required              Boolean                 @default(false)
  options               String?
  ticketTypeId          String?
  isLeaderOnly          Boolean                 @default(false)
  placeholder           String?
  validationRules       String?
  AttendeeFieldResponse AttendeeFieldResponse[]
  event                 Event                   @relation(fields: [eventId], references: [eventId])
  ticketType            TicketType?             @relation(fields: [ticketTypeId], references: [ticketTypeId])

  @@index([eventId, required])
  @@index([ticketTypeId])
}

model TicketType {
  ticketTypeId      String               @id @default(uuid())
  eventId           String
  name              String
  description       String?
  price             Float
  quantity          Int
  salesCutoff       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  soldCount         Int                  @default(0)
  discountReason    String?
  discountedPrice   Float?
  platformfee       Int                  @default(0)
  ticketPrefix      String?
  platformfeePerc   Float                @default(0.025)
  capacityLimit     Int?
  discountQuantity  Int?
  discountSoldCount Int                  @default(0)
  feeBornBy         FeeBornBy            @default(HOST)
  gatewayFeePerc    Float                @default(0.025)
  groupId           String?
  maxTeamSize       Int?
  minTeamSize       Int?
  paused            Boolean              @default(false)
  salesClosesAt     DateTime?
  salesOpensAt      DateTime?
  visibility        TicketTypeVisibility @default(PUBLIC)
  CustomField       CustomField[]
  Team              Team[]
  Ticket            Ticket[]
  event             Event                @relation(fields: [eventId], references: [eventId])
  TicketTypeGroup   TicketTypeGroup?     @relation(fields: [groupId], references: [groupId])

  @@index([eventId, price])
  @@index([salesCutoff])
  @@index([groupId])
  @@index([paused, eventId])
  @@index([visibility, eventId])
}

model Ticket {
  ticketId              String                  @id @default(uuid())
  ticketTypeId          String?
  userId                String
  status                TicketPaymentStatus     @default(PENDING)
  quantity              Int
  totalPrice            Float
  qrCode                String?                 @unique
  checkedIn             Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  bookingId             String?
  eventId               String
  faceValue             Float                   @default(0)
  feeBornBy             FeeBornBy               @default(HOST)
  gatewayFee            Float                   @default(0)
  invitedBy             String?
  isGuestTicket         Boolean                 @default(false)
  platformFee           Float                   @default(0)
  teamId                String?
  wasDiscounted         Boolean                 @default(false)
  AttendeeFieldResponse AttendeeFieldResponse[]
  CheckIn               CheckIn?
  Refund                Refund[]
  TeamMember            TeamMember?
  Booking               Booking?                @relation(fields: [bookingId], references: [bookingId])
  Event                 Event                   @relation(fields: [eventId], references: [eventId])
  Team                  Team?                   @relation(fields: [teamId], references: [teamId])
  ticketType            TicketType?             @relation(fields: [ticketTypeId], references: [ticketTypeId])
  user                  User                    @relation(fields: [userId], references: [userId])
  TicketScanLog         TicketScanLog[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([ticketTypeId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([eventId, checkedIn])
  @@index([eventId, status, checkedIn])
  @@index([eventId, status])
  @@index([teamId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_ticket_success_user", where: raw("(status = 'SUCCESS'::\"TicketPaymentStatus\")"))
}

model AttendeeFieldResponse {
  responseId String      @id @default(uuid())
  ticketId   String
  fieldId    String
  value      String
  createdAt  DateTime    @default(now())
  field      CustomField @relation(fields: [fieldId], references: [fieldId])
  ticket     Ticket      @relation(fields: [ticketId], references: [ticketId])

  @@index([ticketId])
  @@index([fieldId, value])
}

model TicketChecker {
  checkerId     String          @id @default(uuid())
  listerId      String
  eventId       String?
  username      String
  password      String
  active        Boolean         @default(true)
  deprecated    Boolean         @default(false)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime        @default(now())
  createdBy     String?
  name          String?
  permissions   String[]
  event         Event?          @relation(fields: [eventId], references: [eventId])
  lister        Lister          @relation(fields: [listerId], references: [listerId])
  TicketScanLog TicketScanLog[]

  @@unique([eventId, username])
  @@index([listerId, active])
  @@index([eventId, active])
  @@index([expiresAt])
  @@index([eventId, listerId], map: "idx_ticketchecker_active", where: raw("((active = true) AND (deprecated = false))"))
}

model TicketScanLog {
  scanId            String         @id @default(uuid())
  ticketId          String
  checkerId         String?
  performedByUserId String?
  scannedAt         DateTime       @default(now())
  action            String
  success           Boolean
  note              String?
  deviceInfo        String?
  ipAddress         String?
  eventId           String
  location          String?
  checker           TicketChecker? @relation(fields: [checkerId], references: [checkerId])
  Event             Event          @relation(fields: [eventId], references: [eventId])
  performedByUser   User?          @relation(fields: [performedByUserId], references: [userId])
  ticket            Ticket         @relation(fields: [ticketId], references: [ticketId])

  @@index([ticketId, scannedAt(sort: Desc)])
  @@index([checkerId, scannedAt(sort: Desc)])
  @@index([success, scannedAt(sort: Desc)])
  @@index([eventId, scannedAt(sort: Desc)])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model DiscountCode {
  codeId                  String        @id @default(uuid())
  eventId                 String?
  code                    String        @unique
  description             String?
  discountPct             Float?
  maxUses                 Int?
  usesCount               Int           @default(0)
  validFrom               DateTime?
  validTo                 DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  discountAmt             Float?
  discountType            DiscountType
  maxDiscount             Float?
  minOrderAmt             Float?
  affiliateCode           String?       @unique
  isActive                Boolean       @default(true)
  kind                    DiscountKind  @default(PROMO)
  listerId                String?
  referrerId              String?
  resourceId              String?
  shareToUnlockClickCount Int           @default(0)
  shareToUnlockThreshold  Int?
  venueId                 String?
  Booking                 Booking[]
  event                   Event?        @relation(fields: [eventId], references: [eventId])
  Lister                  Lister?       @relation(fields: [listerId], references: [listerId])
  User                    User?         @relation(fields: [referrerId], references: [userId])
  SlotBooking             SlotBooking[]

  @@index([eventId, validFrom, validTo])
  @@index([code, eventId])
  @@index([affiliateCode])
  @@index([isActive])
  @@index([kind, eventId])
  @@index([listerId])
  @@index([referrerId])
}

model EventAnalytics {
  analyticsId           String   @id @default(uuid())
  eventId               String   @unique
  views                 Int      @default(0)
  clicks                Int      @default(0)
  ticketsSold           Int      @default(0)
  revenue               Decimal  @default(0)
  conversionRate        Float    @default(0)
  lastUpdated           DateTime @default(now()) @updatedAt
  clicksByDay           Json?
  createdAt             DateTime @default(now())
  deviceBreakdown       Json?
  revenueByDay          Json?
  salesByDay            Json?
  trafficSources        Json?
  viewsByDay            Json?
  ticketTypesSalesByDay Json?
  abandonedCheckouts    Int      @default(0)
  followCount           Int      @default(0)
  friendsLikedBy        Json?
  likeCount             Int      @default(0)
  locationData          Json?
  shares                Int      @default(0)
  uniqueVisitors        Int      @default(0)
  event                 Event    @relation(fields: [eventId], references: [eventId])

  @@index([revenue(sort: Desc)])
  @@index([ticketsSold(sort: Desc)])
  @@index([lastUpdated(sort: Desc)])
  @@index([views(sort: Desc)])
}

model ListerAnalytics {
  id               String   @id @default(uuid())
  listerId         String   @unique
  totalEvents      Int      @default(0)
  totalRevenue     Float    @default(0)
  totalTicketsSold Int      @default(0)
  lastUpdated      DateTime @default(now()) @updatedAt
  avgRating        Float    @default(0)
  pastEvents       Int      @default(0)
  upcomingEvents   Int      @default(0)
  lister           Lister   @relation(fields: [listerId], references: [listerId])

  @@index([totalRevenue(sort: Desc)])
  @@index([totalTicketsSold(sort: Desc)])
  @@index([avgRating(sort: Desc)])
}

model Refund {
  refundId           String       @id @default(uuid())
  ticketId           String
  amount             Float
  reason             String?
  status             RefundStatus @default(PENDING)
  processedBy        String?
  processedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  additionalDetails  String?
  adminNotes         String?
  approvedAt         DateTime?
  approvedBy         String?
  eventId            String
  gatewayFeeRefund   Float        @default(0)
  lastAttemptAt      DateTime?
  listerRefund       Float        @default(0)
  platformFeeRefund  Float        @default(0)
  processingAttempts Int          @default(0)
  razorpayRefundId   String?
  rejectedAt         DateTime?
  rejectedBy         String?
  rejectionReason    String?
  requestedAt        DateTime     @default(now())
  userId             String
  Event              Event        @relation(fields: [eventId], references: [eventId])
  ticket             Ticket       @relation(fields: [ticketId], references: [ticketId])
  User               User         @relation(fields: [userId], references: [userId])
}

model Notification {
  notificationId String    @id @default(uuid())
  userId         String
  title          String
  message        String
  link           String?
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  sent           Boolean   @default(false)
  sentAt         DateTime?
  type           String?   @default("info")
  user           User      @relation(fields: [userId], references: [userId])

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([sent, createdAt])
  @@index([userId, createdAt(sort: Desc)], map: "idx_notification_unread", where: raw("(read = false)"))
  @@index([createdAt], map: "idx_notification_unsent", where: raw("(sent = false)"))
}

model PushSubscription {
  subscriptionId String   @id @default(uuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastUsedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [userId])

  @@index([userId, isActive])
}

model AuditLog {
  logId      String   @id
  userId     String?
  userRole   Role?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
}

model Booking {
  bookingId             String            @id
  userId                String
  eventId               String
  status                BookingStatus     @default(HELD)
  subtotal              Float
  discountCodeId        String?
  discountAmount        Float             @default(0)
  platformFee           Float             @default(0)
  gatewayFee            Float             @default(0)
  feesBornBy            BookingFeesBornBy @default(HOST)
  total                 Float
  holdExpiresAt         DateTime
  qrCode                String?           @unique
  city                  String?
  state                 String?
  userAgent             String?
  referrer              String?
  commonFieldResponses  Json              @default("[]")
  registrationAnswers   Json              @default("{}")
  approvalClaimToken    String?           @unique
