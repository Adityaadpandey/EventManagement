# ----------------------------
# Build stage
# ----------------------------
FROM node:22-alpine AS builder

WORKDIR /workspace

# Install pnpm (stable version)
RUN npm install -g pnpm@9.15.9

# Copy entire monorepo (required for TurboRepo)
COPY . .

# Install all dependencies for workspace
RUN pnpm install

# Build logger package
RUN pnpm --filter ./packages/logger run build

# Build backend service
RUN pnpm --filter ./servers/user-server run build

# Generate prisma client
WORKDIR /workspace/servers/user-server
RUN npx prisma generate


# ----------------------------
# Production stage
# ----------------------------
FROM node:22-alpine

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@9.15.9

# Copy full workspace (needed for runtime resolution)
COPY . .

# Install production dependencies for workspace (IMPORTANT FIX)
RUN pnpm install --frozen-lockfile --prod

# Copy build outputs from builder
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

ENV NODE_ENV=production

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
