# ----------------------------
# Build stage
# ----------------------------
FROM node:22-alpine AS builder

WORKDIR /workspace

# Install pnpm (stable, avoids approve-builds issues)
RUN npm install -g pnpm@9.15.9

# Copy full repo (required for TurboRepo + Prisma + workspaces)
COPY . .

# Install all dependencies (workspace-safe)
RUN pnpm install

# Build shared packages first (logger)
RUN pnpm --filter ./packages/logger run build

# IMPORTANT: generate Prisma client BEFORE server build
WORKDIR /workspace/servers/user-server
RUN pnpm exec prisma generate

# Build backend server AFTER Prisma generation
RUN pnpm run build


# ----------------------------
# Production stage
# ----------------------------
FROM node:22-alpine

WORKDIR /workspace

RUN npm install -g pnpm@9.15.9

# Copy full repo structure needed at runtime
COPY . .

# Install production dependencies only (safe in runtime)
RUN pnpm install --prod --frozen-lockfile

# Copy build outputs from builder
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

ENV NODE_ENV=production

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
