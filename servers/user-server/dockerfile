# Build stage
FROM node:22-alpine AS builder

WORKDIR /workspace

COPY .npmrc ./
COPY packages ./packages

RUN npm install -g pnpm

WORKDIR /workspace/packages/logger

RUN printf '%s\n' \
'onlyBuiltDependencies[]=@datadog/pprof' \
'onlyBuiltDependencies[]=@newrelic/fn-inspect' \
'onlyBuiltDependencies[]=@newrelic/native-metrics' \
'onlyBuiltDependencies[]=protobufjs' \
>> ~/.npmrc

RUN cat ~/.npmrc

RUN pnpm install \
  --allow-build=@datadog/pprof \
  --allow-build=@newrelic/fn-inspect \
  --allow-build=@newrelic/native-metrics \
  --allow-build=protobufjs \
  && pnpm run build
WORKDIR /workspace

COPY servers/user-server/package*.json ./servers/user-server/
COPY servers/user-server/tsconfig.json ./servers/user-server/
COPY servers/user-server/ ./servers/user-server/

WORKDIR /workspace/servers/user-server

RUN pnpm install \
  --allow-build=@datadog/pprof \
  --allow-build=@newrelic/fn-inspect \
  --allow-build=@newrelic/native-metrics \
  --allow-build=protobufjs

RUN npx prisma generate
RUN pnpm run build

# ------------------------------------------------------------

# Production stage
FROM node:22-alpine

WORKDIR /workspace

COPY .npmrc ./

# Copy built assets
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/package*.json ./servers/user-server/
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

RUN mkdir -p /workspace/certs

ENV NODE_ENV=production

ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

ARG BUILD_DATE
ENV BUILD_DATE=${BUILD_DATE}

RUN npm install -g pnpm

RUN pnpm install \
  --allow-build=@datadog/pprof \
  --allow-build=@newrelic/fn-inspect \
  --allow-build=@newrelic/native-metrics \
  --allow-build=protobufjs --prod

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
