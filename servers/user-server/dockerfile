FROM node:22-alpine AS builder

WORKDIR /workspace

COPY packages ./packages

RUN npm install -g pnpm

WORKDIR /workspace/packages/database
RUN pnpm install && pnpm run build

WORKDIR /workspace/packages/logger
RUN pnpm install && pnpm run build


WORKDIR /workspace

COPY server/user-server/package*.json ./server/user-server/

WORKDIR /workspace/server/user-server
RUN pnpm install

COPY server/user-server/package*.json ./
COPY server/user-server/tsconfig.json ./
COPY server/user-server/src ./src

RUN pnpm run build

# ------------------------------------------------------------

# Production stage
FROM node:22-alpine

WORKDIR /workspace

# Copy built assets from builder
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/server/user-server/dist ./server/user-server/dist
COPY --from=builder /workspace/server/user-server/package*.json ./server/user-server/

WORKDIR /workspace/server/user-server

ENV NODE_ENV=production

RUN npm install -g pnpm

RUN pnpm i --prod

EXPOSE 7001

CMD ["node", "dist/app.js"]
