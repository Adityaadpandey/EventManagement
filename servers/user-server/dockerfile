# ----------------------------
# Build stage
# ----------------------------
FROM node:22-alpine AS builder

WORKDIR /workspace

# Install pnpm (stable version that does NOT enforce approve-builds)
RUN npm install -g pnpm@9.15.9

# Copy repo
COPY . .

# Install and build logger package
WORKDIR /workspace/packages/logger
RUN pnpm install
RUN pnpm run build

# Install and build server
WORKDIR /workspace/servers/user-server
RUN pnpm install
RUN npx prisma generate
RUN pnpm run build


# ----------------------------
# Production stage
# ----------------------------
FROM node:22-alpine

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@9.15.9

# Copy built artifacts
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/package*.json ./servers/user-server/
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

# Create cert directory
RUN mkdir -p /workspace/certs

ENV NODE_ENV=production

ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

ARG BUILD_DATE
ENV BUILD_DATE=${BUILD_DATE}

# Install production deps only
RUN pnpm install --prod

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
