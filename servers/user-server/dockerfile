# ----------------------------
# Build stage
# ----------------------------
FROM node:22-alpine AS builder

WORKDIR /workspace

RUN npm install -g pnpm@9.15.9

COPY . .

# Install FULL dependencies (IMPORTANT)
RUN pnpm install

# Build workspace packages
RUN pnpm --filter ./packages/logger run build
RUN pnpm --filter ./servers/user-server run build

# Prisma generate
WORKDIR /workspace/servers/user-server
RUN npx prisma generate


# ----------------------------
# Production stage
# ----------------------------
FROM node:22-alpine

WORKDIR /workspace

RUN npm install -g pnpm@9.15.9

# Copy only runtime artifacts (NOT node_modules install step)
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/package*.json ./servers/user-server/
COPY --from=builder /workspace/servers/user-server/node_modules ./servers/user-server/node_modules
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

ENV NODE_ENV=production

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
