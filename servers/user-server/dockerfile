# ----------------------------
# Build stage
# ----------------------------
FROM node:22-alpine AS builder

WORKDIR /workspace

RUN npm install -g pnpm@9.15.9

COPY . .

# Install all deps (needed for build + husky + prisma + native modules)
RUN pnpm install

# Build logger package
RUN pnpm --filter ./packages/logger run build

# Generate prisma BEFORE build
WORKDIR /workspace/servers/user-server
RUN pnpm exec prisma generate

# Build server
RUN pnpm run build


# ----------------------------
# Production stage
# ----------------------------
FROM node:22-alpine

WORKDIR /workspace

RUN npm install -g pnpm@9.15.9

COPY . .

# IMPORTANT FIX:
# disable lifecycle scripts so husky does NOT run
ENV HUSKY=0
ENV NPM_CONFIG_IGNORE_SCRIPTS=true

# Install production deps WITHOUT running prepare scripts
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Copy build outputs
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/servers/user-server/dist ./servers/user-server/dist
COPY --from=builder /workspace/servers/user-server/newrelic.js ./servers/user-server/newrelic.js

WORKDIR /workspace/servers/user-server

ENV NODE_ENV=production

EXPOSE 7001

CMD ["node", "-r", "newrelic", "dist/bin.js"]
