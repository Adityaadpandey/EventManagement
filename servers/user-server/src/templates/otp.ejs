<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Login with OTP | TIXIN</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', Arial, sans-serif;
            background-color: #fff;
            margin: 0;
            padding: 0;
        }

        .container {
            background-color: #ffffff;
            max-width: 500px;
            margin: 40px auto;
            padding: 30px 25px;
            border-radius: 16px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
            border: 1px solid #ffeb7d;
        }

        h2 {
            color: #b68700;
            /* Darker yellow */
            margin-bottom: 15px;
            font-size: 24px;
        }

        p {
            font-size: 16px;
            color: #2e2e2e;
            margin: 12px 0;
        }

        .otp-box {
            font-size: 32px;
            font-weight: 700;
            background-color: #FFE348;
            padding: 20px 25px;
            border-radius: 16px;
            text-align: center;
            color: #000000;
            /* Changed for clarity */
            letter-spacing: 6px;
            margin: 25px 0;
            border-bottom: 4px solid #FFDA0A;
            box-shadow: 0 0 12px rgba(255, 211, 0, 0.3);
        }

        em {
            color: #777;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .container {
                margin: 20px;
                padding: 20px;
            }

            .otp-box {
                font-size: 26px;
                padding: 15px;
                letter-spacing: 4px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Your One-Time Password (OTP)</h2>
        <p>Use the following OTP to log in to <strong>TIXIN</strong>:</p>
        <div class="otp-box">
            <%= otp %>
        </div>
        <p><em>This OTP is valid for 10 minutes. Please do not share it with anyone.</em></p>
    </div>
</body>

</html>
