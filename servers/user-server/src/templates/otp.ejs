<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Login with OTP | TIXIN</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', Arial, sans-serif;
            background-color: #f0f4ff;
            margin: 0;
            padding: 0;
        }

        .container {
            background-color: #ffffff;
            max-width: 500px;
            margin: 40px auto;
            padding: 30px 25px;
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid #e0e5ff;
        }

        h2 {
            color: #7d6bff;
            margin-bottom: 15px;
            font-size: 24px;
        }

        p {
            font-size: 16px;
            color: #2e2e2e;
            margin: 12px 0;
        }

        .otp-box {
            font-size: 28px;
            font-weight: 700;
            background-color: #e9e4ff;
            padding: 20px 25px;
            border-radius: 12px;
            text-align: center;
            color: #7d6bff;
            letter-spacing: 3px;
            margin: 25px 0;
            border: 1px dashed #b5aaff;
        }

        em {
            color: #777;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .container {
                margin: 20px;
                padding: 20px;
            }

            .otp-box {
                font-size: 22px;
                padding: 15px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Your One-Time Password (OTP)</h2>
        <p>Use the following OTP to log in to <strong>TIXIN</strong>:</p>
        <div class="otp-box">
            <%= otp %>
        </div>
        <p><em>This OTP is valid for 10 minutes. Please do not share it with anyone.</em></p>
    </div>
</body>

</html>
