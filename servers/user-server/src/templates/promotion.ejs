<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title><%= eventTitle %> - <%= listerName %></title>
    <!-- [if mso]>
    <style type="text/css">
        body, table, td {font-family: Arial, Helvetica, sans-serif !important;}
    </style>
    <![endif] -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f5f7;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            line-height: 1.6;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f5f5f7;
            padding: 20px 0;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        }

        .header {
            background: linear-gradient(135deg, #ffda0a 0%, #ffda0abc 100%);
            padding: 40px 30px;
            text-align: center;
            color: #ffffff;
        }

        .header-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 15px;
            backdrop-filter: blur(10px);
        }

        .header h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 8px 0;
            line-height: 1.2;
        }

        .header-subtitle {
            font-size: 16px;
            opacity: 0.95;
            font-weight: 400;
        }

        .content {
            padding: 40px 30px;
        }

        .greeting {
            font-size: 18px;
            color: #1d1d1f;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .intro-text {
            color: #6e6e73;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .event-banner {
            width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 0 0 30px 0;
            display: block;
        }

        .event-card {
            /* background: linear-gradient(135deg, #ffda0a 0%, #ffda0abc 100%); */
            /* padding: 30px; */
            border-radius: 16px;
            /* margin: 30px 0; */
        }

        .event-title {
            font-size: 24px;
            font-weight: 700;
            color: #1d1d1f;
            margin: 0 0 24px 0;
            line-height: 1.3;
        }

        .detail-row {
            display: table;
            width: 100%;
            margin: 16px 0;
            background: rgba(255, 255, 255, 0.7);
            padding: 16px;
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }

        .detail-icon {
            display: table-cell;
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #ffda0a 0%, #ffda0abc 100%);
            border-radius: 12px;
            text-align: center;
            vertical-align: middle;
            font-size: 22px;
            padding: 12px;
        }

        .detail-content {
            display: table-cell;
            vertical-align: middle;
            padding-left: 16px;
        }

        .detail-label {
            font-size: 12px;
            font-weight: 600;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .detail-value {
            font-size: 15px;
            font-weight: 600;
            color: #1d1d1f;
        }

        .custom-message {
            background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
            padding: 24px;
            border-radius: 12px;
            margin: 30px 0;
        }

        .custom-message-label {
            font-size: 13px;
            font-weight: 700;
            color: #8b4513;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .custom-message-text {
            font-size: 15px;
            line-height: 1.6;
            color: #1d1d1f;
            margin: 0;
        }

        .chips-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 0 0;
        }

        .chip {
            display: inline-block;
            padding: 8px 16px;
            margin: 4px 4px;
            background: #f5f5f7;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #1d1d1f;
            border: 1px solid #e5e5ea;
        }

        .description {
            color: #6e6e73;
            font-size: 15px;
            line-height: 1.7;
            margin: 24px 0;
        }

        .price-value {
            font-size: 24px;
            font-weight: 700;
            color: #667eea;
        }

        .price-original {
            font-size: 14px;
            color: #86868b;
            text-decoration: line-through;
            display: block;
            margin-top: 4px;
        }

        .cta-container {
            text-align: center;
            margin: 40px 0;
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #ffda0a 0%, #ffda0abc 100%);
            color: #ffffff;
            padding: 16px 48px;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4);
            transition: all 0.3s ease;
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(102, 126, 234, 0.5);
        }

        .divider {
            height: 1px;
            background: linear-gradient(to right, transparent, #e5e5ea, transparent);
            margin: 40px 0;
        }

        .lister-bio {
            background: #f5f5f7;
            padding: 24px;
            border-radius: 12px;
            margin: 30px 0;
        }

        .lister-bio-title {
            font-size: 16px;
            font-weight: 700;
            color: #1d1d1f;
            margin-bottom: 12px;
        }

        .lister-bio-text {
            color: #6e6e73;
            font-size: 14px;
            line-height: 1.6;
        }

        .social-section {
            margin: 30px 0;
            padding: 24px;
            background: #f5f5f7;
            border-radius: 12px;
        }

        .social-title {
            font-size: 16px;
            font-weight: 700;
            color: #1d1d1f;
            margin-bottom: 16px;
            text-align: center;
        }

        .social-links {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            padding: 10px 20px;
            background: #ffffff;
            border: 2px solid #e5e5ea;
            border-radius: 10px;
            text-decoration: none;
            color: #1d1d1f;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .social-link:hover {
            border-color: #667eea;
            background: #f5f7fa;
        }

        .social-icon {
            margin-right: 8px;
            font-size: 18px;
        }

        .footer {
            background: #1d1d1f;
            padding: 32px 30px;
            text-align: center;
            color: #ffffff;
        }

        .footer-text {
            color: #a1a1a6;
            font-size: 13px;
            line-height: 1.6;
            margin: 8px 0;
        }

        .footer-brand {
            color: #ffffff;
            font-weight: 700;
            font-size: 16px;
            margin-top: 16px;
        }

        /* Mobile Optimization */
        @media only screen and (max-width: 600px) {
            .email-wrapper {
                padding: 10px 0;
            }

            .container {
                border-radius: 0;
                margin: 0;
            }

            .header {
                padding: 30px 20px;
            }

            .header h1 {
                font-size: 24px;
            }

            .content {
                padding: 30px 20px;
            }

            .event-title {
                font-size: 20px;
            }

            /* .event-card {
                padding: 20px;
            } */

            .detail-row {
                display: block;
                padding: 12px;
            }

            .detail-icon {
                display: inline-block;
                margin-bottom: 8px;
            }

            .detail-content {
                display: block;
                padding-left: 0;
                margin-top: 8px;
            }

            .price-original {
                display: inline;
                margin-left: 8px;
            }

            .social-links {
                flex-direction: column;
            }

            .social-link {
                width: 100%;
                justify-content: center;
            }

            .cta-button {
                display: block;
                width: 100%;
                padding: 16px 24px;
            }

            .chips-container {
                gap: 8px;
            }

            .chip {
                font-size: 12px;
                padding: 6px 12px;
            }
        }

        /* Dark Mode Support */
        @media (prefers-color-scheme: dark) {
            .container {
                background-color: #1c1c1e;
            }

            .event-title,
            .greeting,
            .lister-bio-title,
            .social-title,
            .detail-value {
                color: #f5f5f7;
            }

            .intro-text,
            .description,
            .lister-bio-text {
                color: #a1a1a6;
            }

            .event-card {
                background: linear-gradient(135deg, #2c2c2e 0%, #3a3a3c 100%);
            }

            .detail-row {
                background: rgba(58, 58, 60, 0.7);
            }

            .chip {
                background: #2c2c2e;
                border-color: #3a3a3c;
                color: #f5f5f7;
            }

            .lister-bio,
            .social-section {
                background: #2c2c2e;
            }

            .social-link {
                background: #3a3a3c;
                border-color: #48484a;
                color: #f5f5f7;
            }
        }
    </style>
</head>

<body>
    <div class="email-wrapper">
        <div class="container">
            <!-- Header -->
            <div class="header">
                <div class="header-badge">NEW EVENT</div>
                <h1><%= eventTitle %></h1>
                <div class="header-subtitle">Presented by <%= listerName %></div>
            </div>

            <!-- Content -->
            <div class="content">
                <div class="greeting">Hey there! 👋</div>

                <p class="intro-text">
                    We're excited to share something special with you! As someone who's been part of our community,
                    you're getting early access to our latest event.
                </p>

                <!-- Event Banner -->
                <% if (eventBanner) { %>
                <img src="<%= eventBanner %>" alt="<%= eventTitle %>" class="event-banner" />
                <% } %>

                <!-- Event Details Card -->
                <div class="event-card">
                    <h2 class="event-title"><%= eventTitle %></h2>

                    <div class="detail-row">
                        <!-- <div class="detail-icon">📅</div> -->
                        <div class="detail-content">
                            <div class="detail-label">Date</div>
                            <div class="detail-value">
                                <%= new Date(eventDate).toLocaleDateString('en-US', {
                                    weekday: 'long',
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric'
                                }) %>
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <!-- <div class="detail-icon">🕐</div> -->
                        <div class="detail-content">
                            <div class="detail-label">Time</div>
                            <div class="detail-value">
                                <%= new Date(eventTime).toLocaleTimeString('en-US', {
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    hour12: true
                                }) %>
                            </div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <!-- <div class="detail-icon">📍</div> -->
                        <div class="detail-content">
                            <div class="detail-label">Location</div>
                            <div class="detail-value"><%= eventLocation %></div>
                        </div>
                    </div>
                </div>

                <!-- Custom Message -->
                <% if (customContent) { %>
                <div class="custom-message">
                    <div class="custom-message-label">💌 Special Message</div>
                    <p class="custom-message-text"><%= customContent %></p>
                </div>
                <% } %>

                <!-- Chips/Tags -->
                <% if (chips && chips.length > 0) { %>
                <div class="chips-container">
                    <% chips.forEach(function(chip) { %>
                    <span class="chip"><%= chip %></span>
                    <% }); %>
                </div>
                <% } %>

                <!-- Description -->
                <% if (eventDescription) { %>
                <p class="description"><%- eventDescription.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').trim() %></p>
                <% } %>


                <!-- CTA Button -->
                <div class="cta-container">
                    <a href="<%= eventLink %>" class="cta-button">
                        Get Your Tickets →
                    </a>
                </div>

                <div class="divider"></div>

                <!-- Social Links -->
                <% if (listerWebsite || listerInstagram || listerFacebook || listerX) { %>
                <div class="social-section">
                    <div class="social-title">Stay Connected</div>
                    <div class="social-links">
                        <% if (listerWebsite) { %>
                        <a href="<%= listerWebsite %>" class="social-link" target="_blank" rel="noopener">
                            <span class="social-icon">🌐</span> Website
                        </a>
                        <% } %>
                        <% if (listerInstagram) { %>
                        <a href="<%= listerInstagram %>" class="social-link" target="_blank" rel="noopener">
                            <span class="social-icon">📷</span> Instagram
                        </a>
                        <% } %>
                        <% if (listerFacebook) { %>
                        <a href="<%= listerFacebook %>" class="social-link" target="_blank" rel="noopener">
                            <span class="social-icon">👥</span> Facebook
                        </a>
                        <% } %>
                        <% if (listerX) { %>
                        <a href="<%= listerX %>" class="social-link" target="_blank" rel="noopener">
                            <span class="social-icon">✖️</span> X
                        </a>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Footer -->
            <div class="footer">
                <p class="footer-text">
                    You're receiving this because you've attended events by <strong><%= listerName %></strong>.
                </p>
                <p class="footer-text">
                    We only send emails about events we think you'll love.
                </p>
                <p class="footer-brand">
                    Tixin · Making Events Memorable
                </p>
            </div>
        </div>
    </div>
</body>
</html>
