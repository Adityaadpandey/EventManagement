<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Your Ticket</title>
    <style>
        body {
            font-family: 'Inter', Arial, sans-serif;
            background-color: #fff8cc;
            /* light warm yellow background */
            margin: 0;
            padding: 0;
        }

        .container {
            background-color: #ffffff;
            max-width: 600px;
            margin: 40px auto;
            padding: 30px 25px;
            border-radius: 16px;
            border: 2px dashed #ffda0a;
            box-shadow: 0 6px 20px rgba(255, 211, 0, 0.3);
            position: relative;
            overflow: visible;
        }

        /* Create "cut" circles on left and right edges */
        .container::before,
        .container::after {
            content: '';
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 30px;
            height: 30px;
            background: #fff8cc;
            /* same as page bg */
            border-radius: 50%;
            box-shadow: 0 0 0 2px #ffda0a;
            z-index: 10;
        }

        .container::before {
            left: -15px;
        }

        .container::after {
            right: -15px;
        }

        h2 {
            color: #b68700;
            /* warm dark yellow */
            font-size: 24px;
            margin-bottom: 15px;
        }

        p,
        li {
            font-size: 16px;
            color: #2e2e2e;
            margin: 8px 0;
        }

        ul {
            list-style: none;
            padding: 0;
        }

        li {
            margin-bottom: 8px;
        }

        strong {
            color: #000;
        }

        .qr-container {
            text-align: center;
            margin-top: 25px;
        }

        .qr-container img {
            width: 150px;
            height: 150px;
            border: 4px solid #FFE348;
            /* bright yellow border */
            border-radius: 16px;
            background-color: #fff8cc;
            box-shadow: 0 0 12px rgba(255, 211, 0, 0.3);
        }

        .qr-container p {
            margin-top: 10px;
            font-size: 14px;
            color: #555;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Hello <%= name %>,</h2>
        <p>Thanks for booking! Here are your ticket details:</p>
        <ul>
            <li><strong>Event:</strong>
                <%= ticket.eventName %>
            </li>
            <li><strong>Ticket ID:</strong>
                <%= ticket.ticketId %>
            </li>
            <li><strong>Seat Number:</strong>
                <%= ticket.seatNumber %>
            </li>
            <li><strong>Date:</strong>
                <%= ticket.date %>
            </li>
            <li><strong>Venue:</strong>
                <%= ticket.venue %>
            </li>
        </ul>
        <div class="qr-container">
            <p>Scan this QR code at the entry gate:</p>
            <img src="cid:ticketqr@Tixin" alt="Ticket QR Code" />
        </div>
        <p>Enjoy the event!</p>

<div style="
      margin-top:25px;
      padding:18px;
      border-top:1px dashed #ffda0a;
      color:#444;
      font-size:14px;
    ">
    <p style="margin:0 0 15px 0; font-weight:bold; font-size:15px;">
        Thank you for choosing <%= (ticket && ticket.CompanyName) || 'our service' %>. For more information

    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;">
        <% if (ticket.website) { %>
            <tr>
                <td style="padding: 10px 0;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                            <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                <table cellspacing="0" cellpadding="0" border="0"
                                    style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                    <tr>
                                        <td align="center" valign="middle"
                                            style="font-size:20px; color:#b68700; font-weight:bold;">
                                            🌐
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="vertical-align:middle;">
                                <a href="<%= ticket.website %>" target="_blank" rel="noreferrer"
                                    style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                    <%= ticket.website %>
                                </a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <% } %>

                <% if (ticket.InstagramLink) { %>
                    <tr>
                        <td style="padding: 10px 0;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                        <table cellspacing="0" cellpadding="0" border="0"
                                            style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                            <tr>
                                                <td align="center" valign="middle"
                                                    style="font-size:20px; color:#b68700; font-weight:bold;">
                                                    📷
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="vertical-align:middle;">
                                        <a href="<%= ticket.InstagramLink %>" target="_blank" rel="noreferrer"
                                            style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                            Instagram
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <% } %>

                        <% if (ticket.FacebookLink) { %>
                            <tr>
                                <td style="padding: 10px 0;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                                <table cellspacing="0" cellpadding="0" border="0"
                                                    style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                                    <tr>
                                                        <td align="center" valign="middle"
                                                            style="font-size:20px; color:#b68700; font-weight:bold;">
                                                            👥
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="vertical-align:middle;">
                                                <a href="<%= ticket.FacebookLink %>" target="_blank" rel="noreferrer"
                                                    style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                                    Facebook
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <% } %>

                                <% if (ticket.XLink) { %>
                                    <tr>
                                        <td style="padding: 10px 0;">
                                            <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                                <tr>
                                                    <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                                        <table cellspacing="0" cellpadding="0" border="0"
                                                            style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                                            <tr>
                                                                <td align="center" valign="middle"
                                                                    style="font-size:20px; color:#b68700; font-weight:bold;">
                                                                    ✖️
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td style="vertical-align:middle;">
                                                        <a href="<%= ticket.XLink %>" target="_blank" rel="noreferrer"
                                                            style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                                            X (Twitter)
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <% } %>
                        <% if (ticket.contactPhone) { const phoneRaw=ticket.contactPhone; const phoneHref=String(phoneRaw).replace(/[^+\d]/g, ''
                            ); %>
                            <tr>
                                <td style="padding: 10px 0;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                                <table cellspacing="0" cellpadding="0" border="0"
                                                    style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                                    <tr>
                                                        <td align="center" valign="middle"
                                                            style="font-size:20px; color:#b68700; font-weight:bold;">
                                                            📞
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>

                                            <td style="vertical-align:middle;">
                                                <a href="tel:<%= phoneHref %>"
                                                    style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                                    <%= phoneRaw %>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <% } %>


                        <% if (ticket.contactEmail) { %>
                            <tr>
                                <td style="padding: 10px 0;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="vertical-align:middle; padding-right:12px; width:44px;">
                                                <table cellspacing="0" cellpadding="0" border="0"
                                                    style="width:44px; height:44px; border-radius:22px; background:#ffe89a; border:2px solid #ffda0a;">
                                                    <tr>
                                                        <td align="center" valign="middle"
                                                            style="font-size:20px; color:#b68700; font-weight:bold;">
                                                            ✉️
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="vertical-align:middle;">
                                                <a href="mailto:<%= ticket.contactEmail %>"
                                                    style="color:#b68700; text-decoration:none; font-weight:600; font-size:15px; display:block;">
                                                    <%= ticket.contactEmail %>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <% } %>

    </table>

    <p style="margin:16px 0 0 0; font-size:12px; color:#6b6b6b; line-height:1.4;">
        We'll only use these channels to share official updates.
    </p>
</div>

    </div>
</body>

</html>
