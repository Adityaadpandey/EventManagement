<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Event Update</title>
    <style>
        body {
            font-family: 'Inter', Arial, sans-serif;
            background-color: #f0f4ff;
            margin: 0;
            padding: 0;
        }

        .container {
            background-color: #ffffff;
            max-width: 600px;
            margin: 40px auto;
            padding: 30px 25px;
            border-radius: 14px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid #e0e5ff;
        }

        h2 {
            color: #7d6bff;
            font-size: 24px;
            margin-bottom: 15px;
        }

        p {
            color: #2e2e2e;
            font-size: 16px;
            margin: 12px 0;
        }

        blockquote {
            border-left: 4px solid #b5aaff;
            background: #f6f4ff;
            padding: 15px 20px;
            margin: 20px 0;
            font-size: 16px;
            color: #2e2e2e;
            border-radius: 10px;
        }

        em {
            font-size: 14px;
            color: #777;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Hello <%= name %>,</h2>
        <p>There’s an update regarding your event:</p>
        <blockquote>
            <%= eventUpdate.message %>
        </blockquote>
        <p><em>Update time: <%= eventUpdate.updatedAt %></em></p>
    </div>
</body>

</html>
