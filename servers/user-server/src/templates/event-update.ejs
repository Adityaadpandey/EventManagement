<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Event Update</title>
    <style>
        body {
            font-family: Arial;
        }

        .container {
            padding: 20px;
            background: #fff8e1;
            border-radius: 5px;
            max-width: 600px;
            margin: auto;
        }

        h2 {
            color: #d17c00;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Hello <%= name %>,</h2>
        <p>There’s an update regarding your event:</p>
        <blockquote>
            <%= eventUpdate.message %>
        </blockquote>
        <p><em>Update time: <%= eventUpdate.updatedAt %></em></p>
    </div>
</body>

</html>
