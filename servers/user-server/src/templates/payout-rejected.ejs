<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Payout Not Approved | TIXIN</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5; margin: 0; padding: 0; }
    .wrapper { max-width: 560px; margin: 40px auto; padding: 0 16px 40px; }
    .card { background: #fff; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); border: 1px solid #ffe88a; overflow: hidden; }
    .header { background: #FFE348; padding: 24px 28px 20px; border-bottom: 2px solid #FFD600; }
    .header .logo { font-size: 20px; font-weight: 700; color: #1a1a1a; letter-spacing: -0.5px; }
    .body { padding: 28px 28px 24px; }
    .badge { display: inline-block; background: #fee2e2; color: #991b1b; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; padding: 4px 10px; border-radius: 99px; margin-bottom: 16px; }
    h2 { font-size: 20px; font-weight: 700; color: #111; margin: 0 0 12px; line-height: 1.3; }
    p { font-size: 15px; color: #444; margin: 0 0 14px; line-height: 1.6; }
    .info-box { background: #fafafa; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px 18px; margin: 18px 0; }
    .info-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f3f4f6; }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-size: 13px; color: #6b7280; }
    .info-value { font-size: 14px; font-weight: 600; color: #111; }
    .remark-box { background: #fff7f7; border: 1px solid #fecaca; border-radius: 10px; padding: 14px 16px; margin: 16px 0; font-size: 14px; color: #7f1d1d; line-height: 1.6; }
    .divider { border: none; border-top: 1px solid #f0f0f0; margin: 22px 0; }
    .footer-note { font-size: 13px; color: #9ca3af; margin: 0; }
    .footer { font-size: 12px; color: #9ca3af; text-align: center; margin-top: 24px; line-height: 1.6; }
    @media (max-width: 600px) { .wrapper { margin: 16px auto; } .header, .body { padding: 20px; } }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="logo">TIXIN</div>
      </div>
      <div class="body">
        <div class="badge">✗ Not Approved</div>
        <h2>Payout Request Not Approved</h2>
        <p>Hi <%= name %>,</p>
        <p>
          Unfortunately, your payout request could not be approved at this time.
          Your balance has been restored and you can submit a new request after resolving any issues.
        </p>

        <div class="info-box">
          <div class="info-row">
            <span class="info-label">Amount</span>
            <span class="info-value"><%= amount %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Reference ID</span>
            <span class="info-value" style="font-family:monospace;font-size:12px;"><%= payoutId %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Status</span>
            <span class="info-value" style="color:#dc2626;">Not Approved</span>
          </div>
        </div>

        <% if (remark) { %>
        <p style="font-size:13px;font-weight:600;color:#6b7280;margin-bottom:6px;">Reason</p>
        <div class="remark-box"><%= remark %></div>
        <% } %>

        <hr class="divider" />
        <p class="footer-note">
          If you believe this is a mistake or need help, contact
          <a href="mailto:support@tixin.in" style="color:#b68700;">support@tixin.in</a>
        </p>
      </div>
    </div>
    <div class="footer">
      © <%= new Date().getFullYear() %> Tixin &nbsp;·&nbsp;
      <a href="https://tixin.in" style="color:#b68700;text-decoration:none;">tixin.in</a>
    </div>
  </div>
</body>
</html>
