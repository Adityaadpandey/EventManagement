<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Event Approved | TIXIN</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', Arial, sans-serif; background-color: #f5f5f5; margin: 0; padding: 0; }
    .wrapper { max-width: 560px; margin: 40px auto; padding: 0 16px 40px; }
    .card { background: #fff; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); border: 1px solid #ffe88a; overflow: hidden; }
    .header { background: #FFE348; padding: 24px 28px 20px; border-bottom: 2px solid #FFD600; }
    .header .logo { font-size: 20px; font-weight: 700; color: #1a1a1a; letter-spacing: -0.5px; }
    .body { padding: 28px 28px 24px; }
    .badge { display: inline-block; background: #d1fae5; color: #065f46; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; padding: 4px 10px; border-radius: 99px; margin-bottom: 16px; }
    h2 { font-size: 20px; font-weight: 700; color: #111; margin: 0 0 12px; line-height: 1.3; }
    p { font-size: 15px; color: #444; margin: 0 0 14px; line-height: 1.6; }
    .event-box { background: #fafafa; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px 18px; margin: 18px 0; }
    .event-box .event-title { font-size: 16px; font-weight: 600; color: #111; margin: 0 0 6px; }
    .event-box .event-meta { font-size: 13px; color: #6b7280; margin: 0; }
    .cta { display: inline-block; margin-top: 18px; background: #FFE348; color: #111; font-size: 14px; font-weight: 600; padding: 12px 24px; border-radius: 10px; text-decoration: none; border-bottom: 3px solid #F5D800; }
    .divider { border: none; border-top: 1px solid #f0f0f0; margin: 22px 0; }
    .footer-note { font-size: 13px; color: #9ca3af; margin: 0; }
    .footer { font-size: 12px; color: #9ca3af; text-align: center; margin-top: 24px; line-height: 1.6; }
    @media (max-width: 600px) { .wrapper { margin: 16px auto; } .header, .body { padding: 20px; } }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="logo">TIXIN</div>
      </div>
      <div class="body">
        <div class="badge">✓ Approved</div>
        <h2>Your Event is Live! 🎉</h2>
        <p>Hi <%= name %>,</p>
        <p>
          Great news! Your event has been reviewed and approved by our team.
          It is now live on Tixin and attendees can start purchasing tickets.
        </p>

        <div class="event-box">
          <p class="event-title">🎉 <%= eventTitle %></p>
          <% if (eventLocation || eventDate) { %>
          <p class="event-meta">
            <% if (eventLocation) { %>📍 <%= eventLocation %><% } %>
            <% if (eventLocation && eventDate) { %> &nbsp;·&nbsp; <% } %>
            <% if (eventDate) { %>📅 <%= eventDate %><% } %>
          </p>
          <% } %>
        </div>

        <a href="https://tixin.in/event/<%= eventId %>" class="cta">View Your Event →</a>

        <hr class="divider" />
        <p class="footer-note">
          Share your event link and start promoting it!
          Need help? Contact us at <a href="mailto:support@tixin.in" style="color:#b68700;">support@tixin.in</a>
        </p>
      </div>
    </div>
    <div class="footer">
      © <%= new Date().getFullYear() %> Tixin &nbsp;·&nbsp;
      <a href="https://tixin.in" style="color:#b68700;text-decoration:none;">tixin.in</a>
    </div>
  </div>
</body>
</html>
